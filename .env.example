# Copy this file as .env and fill in the values.
# NEVER commit a .env file with a real key.

# Required to use the REAL Jev classifier (TypeSafe AI API).
# Create a key in the TypeSafe AI dashboard.
# Not needed if JEV_MOCK=1 (deterministic offline classifier).
TYPESAFE_API_KEY=

# Kubernetes deployment to scale (default: nginx-voice)
K8S_DEPLOYMENT=nginx-voice

# Kubernetes namespace (default: default)
K8S_NAMESPACE=default

# Pod selector for the state breakdown (default: app=nginx-voice,
# i.e. "app=" + the default deployment name)
K8S_POD_SELECTOR=app=nginx-voice

# Pointing at an EXTERNAL cluster (both optional; empty = current behaviour:
# kubectl's default context).
#
# K8S_KUBECONFIG points at a kubeconfig file of the external cluster
# (e.g. ./external.kubeconfig; the *.kubeconfig pattern is in .gitignore).
K8S_KUBECONFIG=
#
# K8S_CONTEXT selects a context from the current kubeconfig
# (`kubectl config get-contexts` to list them).
K8S_CONTEXT=

# Classification confidence threshold (default: 0.5)
CONFIDENCE_THRESHOLD=0.5

# HTTP server port (default: 3000)
PORT=3000

# 1 = use the deterministic offline classifier (no API key required)
JEV_MOCK=