# Copia este archivo como .env y rellena los valores.
# NUNCA commitees un archivo .env con una clave real.

# Requerida para usar el clasificador Jev REAL (API de TypeSafe AI).
# Crea una clave en el dashboard de TypeSafe AI.
# No es necesaria si JEV_MOCK=1 (clasificador offline determinista).
TYPESAFE_API_KEY=

# Despliegue de Kubernetes a escalar (por defecto: nginx-voice)
K8S_DEPLOYMENT=nginx-voice

# Namespace de Kubernetes (por defecto: default)
K8S_NAMESPACE=default

# Selector de pods para el desglose de estados (por defecto: app=nginx-voice,
# es decir "app=" + el nombre por defecto del despliegue)
K8S_POD_SELECTOR=app=nginx-voice

# Apuntar a un cluster EXTERNO (ambas opcionales; vacías = comportamiento
# actual: contexto por defecto de kubectl).
#
# K8S_KUBECONFIG apunta a un archivo kubeconfig del cluster externo
# (p. ej. ./externo.kubeconfig; el patrón *.kubeconfig está en .gitignore).
K8S_KUBECONFIG=
#
# K8S_CONTEXT elige un contexto del kubeconfig actual
# (`kubectl config get-contexts` para listarlos).
K8S_CONTEXT=

# Umbral de confianza de la clasificación (por defecto: 0.5)
CONFIDENCE_THRESHOLD=0.5

# Puerto del servidor HTTP (por defecto: 3000)
PORT=3000

# 1 = usar clasificador offline determinista (no requiere clave de API)
JEV_MOCK=
